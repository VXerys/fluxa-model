# =============================================================================
# Fluxa Voice AI Backend — Environment Variables
# =============================================================================

# --- Whisper STT ---
FLUXA_WHISPER_MODEL_SIZE=small
FLUXA_WHISPER_DEVICE=cpu
FLUXA_WHISPER_COMPUTE_TYPE=int8

# --- Groq Fallback (optional) ---
# Set to "true" to enable Groq LLM fallback for title/category/wallet correction.
ENABLE_GROQ_FALLBACK=false

# Your Groq API key. Required when ENABLE_GROQ_FALLBACK=true.
GROQ_API_KEY=

# Groq API base URL (OpenAI-compatible endpoint).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model to use for the fallback.
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout in seconds for each Groq API call.
GROQ_TIMEOUT_SECONDS=8
